# Copiar a .env (cp .env.example .env). Funciona sin editar en una máquina local.
# Valores de desarrollo: no son credenciales reales. Nunca subir .env al repo.

# Carpeta con los datos publicados (se monta en /datos en solo lectura).
DATOS_DIR=./data

# Usuario con el que corre Airflow (en Linux: el resultado de `id -u`).
AIRFLOW_UID=50000

# Base de datos del producto (separada de la de Airflow).
POSTGRES_USER=novamercado
POSTGRES_PASSWORD=novamercado
POSTGRES_DB=novamercado

# (Se completa en la Fase 1: MLflow, Airflow, JWT, conexiones.)
