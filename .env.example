# Copiar a .env (cp .env.example .env). Funciona sin editar en una máquina local.
# Valores de desarrollo: no son credenciales reales. Nunca subir .env al repo.

# Carpeta con los datos publicados (se monta en /datos en solo lectura).
DATOS_DIR=./data

# Usuario con el que corre Airflow (en Linux: el resultado de `id -u`).
AIRFLOW_UID=50000

# Base de datos del producto (separada de la de Airflow). También guarda la base `mlflow`.
POSTGRES_USER=novamercado
POSTGRES_PASSWORD=novamercado
POSTGRES_DB=novamercado

# Base de datos de Airflow (otra instancia de Postgres).
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow

# Usuario de Airflow (UI en :8080 y API REST que usa el servicio para disparar el DAG).
AIRFLOW_ADMIN_USUARIO=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Secretos internos de Airflow 3 (firma de tokens JWT y sesiones de la UI). Cambiarlos fuera de
# un entorno local.
AIRFLOW_JWT_SECRET=novamercado-jwt-local
AIRFLOW_API_SECRET_KEY=novamercado-api-local
AIRFLOW_FERNET_KEY=

# Modelo en el Model Registry de MLflow.
MODELO_NOMBRE=novamercado
MODELO_ALIAS=champion

# Cada cuántos segundos la API consulta el alias (hot-reload) y revisa sus dependencias.
POLL_MODELO_SEGUNDOS=20
SALUD_SEGUNDOS=10

# Criterio de reemplazo (DECISIONES §4.2): mejora mínima relativa de costo exigida al retador
# frente al vigente en las mismas ventanas (0.005 = 0.5 %).
CRITERIO_MEJORA_MINIMA=0.005
